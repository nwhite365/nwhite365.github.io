---
const { link, text } = Astro.props;
---

<a
  href={link}
  target='_blank'
  class="inline-flex w-auto px-3 text-md font-semibold duration-300 ease-out border rounded-full bg-neutral-900 dark:bg-white dark:text-neutral-900 text-neutral-100 hover:border-neutral-700 border-neutral-900 dark:hover:border-neutral-300 hover:bg-white dark:hover:bg-neutral-700 dark:hover:text-white hover:text-neutral-900"
  style="height: 2.75rem !important;"
>
  <button
  >
    {text}
  </button>
</a>