---
const { link, logo, alt } = Astro.props;
---

<a
  href={link}
  target='_blank'
>
  <button
    class="inline-flex w-auto text-xs font-semibold duration-300 ease-out icon-buttons dark:icon-buttons max-h-16 max-w-16"
  >
    <img src={logo} alt={alt} class="inline-flex px-2 py-2 text-xs"/>
  </button>
</a>