---
const { title, abstract, date, venue, paperurl } = Astro.props;
---

<a
  href={paperurl}
  target="_blank"
  class="duration-300 ease-out group"
>
  <span
    class="relative z-30 block duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1"
  >
    <div class="relative z-50 w-full">
      <div
        class="absolute z-40 w-16 h-16 lg:top-auto top-0 left-0 -translate-y-1/2 -translate-x-1/2 rounded-full"
      >
        <span class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900">
          <span class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700">
            <img src="/assets/images/researchpaper.svg" alt="Click to View Paper" class="inline-flex px-2 py-2 text-xs icon-buttons dark:icon-buttons"/>
          </span>
        </span>
      </div>
      <div class="relative flex flex-col items-stretch p-7 sm:p-3 h-100 rounded-2xl border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600 group-hover:translate-x-1 group-hover:translate-y-1">
        <span class="block w-full px-1 mt-5 mb-1 sm:mt-3">
          <span class="flex items-center mb-0 text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
            <span>{title}</span>

          </span>
          <span class="text-sm text-neutral-600 dark:text-neutral-400 block">
            <strong>Venue:</strong> {venue}
          </span>
          <span class="text-sm text-neutral-600 dark:text-neutral-400 block">
            <strong>Date:</strong> {date}
          </span>
          <span class="text-sm text-neutral-600 dark:text-neutral-400 block">
            <strong>Abstract:</strong> {abstract}
          </span>
        </span>
      </div>
    </div>
  </span>
</a>