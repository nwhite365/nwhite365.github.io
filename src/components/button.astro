---
const { link, text } = Astro.props;
---

<a
  href={link}
  target='_blank'
>
  <button
    class="inline-flex w-auto px-4 py-2 text-md font-semibold duration-300 ease-out border rounded-full bg-neutral-900 dark:bg-white dark:text-neutral-900 text-neutral-100 hover:border-neutral-700 border-neutral-900 dark:hover:border-neutral-300 hover:bg-white dark:hover:bg-neutral-700 dark:hover:text-white hover:text-neutral-900"
  >
    {text}
  </button>
</a>
