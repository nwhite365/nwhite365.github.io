---
import CvButton from "../components/cv-button.astro";
import IconButton from "../components/icon-button.astro";
import Projects from "../components/home/projects.astro";
import Publications from "../components/home/publications.astro";
import Separator from "../components/home/separator.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="Nathan Thomas White">
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-1/2">
        <h1
          class="mb-5 text-4xl font-bold leading-tight md:text-3xl lg:text-4xl dark:text-white"
        >
          Nathan Thomas White
        </h1>
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
          I am a sixth year PhD student, studying Human-Robot Interaction as part of the{" "}
            <a
              href="https://peopleandrobots.wisc.edu/"
              target="_blank"
              class="text-blue"
            >
              People and Robots Lab
            </a>{" "}
            at the University of Wisconsin - Madison. My advisor is{" "}
            <a
              href="http://bilgemutlu.com/"
              target="_blank"
              class="text-blue"
            >
              Dr. Bilge Mutlu.
            </a>{" "}
          I completed my MS degree in Computer Science at the University of
          Wisconsin - Madison, and my BS degree in Computer Science at the
          University of Minnesota - Twin Cities.
        </p>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">
          <div
            class="absolute top-0 z-40 w-16 h-16 -translate-x-6 -translate-y-1/2 lg:top-auto rounded-full"
          >
            <span
              class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900"
            >
              <span
                class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700"
                >👋</span
              >
            </span>
          </div>
          <div class="relative z-30 border border-dashed rounded-2xl" style="padding:15px;">
            <img
              src="/assets/images/nate-profile.jpg"
              loading="eager"
              decoding="auto"
              class="relative z-30 w-full aspect-[790/664] md:max-w-md mx-auto dark:-translate-y-0.5"
              style="border-radius: 5px"
            />
          </div>
        </div>
      </div>
    </div>
    <div class="flex flex-col items-center md:flex-row">
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
          Technology is human-centered, and thus needs to be usable by people. I am passionate about designing systems and technologies that are <strong>usable</strong> and <strong>intuitive</strong> for a wide range of potential users. My work reflects this commitment, as I have built systems and designed interactions that aim to bridge the gap between technical complexity and user understanding. While my work has focused on human-robot interaction, I have incorporated elements from human-computer interaction, design, and human behavior literature to create interfaces and interactions that simplify complex tasks, enabling users to engage with advanced technologies more effectively. By building systems that bridge the gap between technical complexity and user understanding, I aim to make advanced technologies seamlessly integrate into people's daily lives across various domains.
        </p>
    </div>

    <div class="inline-flex items-center space-x-2">
      <IconButton link="mailto:ntwhite@wisc.edu" logo="email" alt="Email"/>
      <IconButton link="https://github.com/nwhite365" logo="github" alt="Github"/>
      <IconButton link="https://www.linkedin.com/in/white-nathan-t/" logo="linkedin" alt="LinkedIn"/>
      <IconButton link="https://scholar.google.com/citations?user=N0G84fwAAAAJ" logo="googlescholar" alt="Google Scholar"/>
      <IconButton link="https://www.researchgate.net/profile/Nathan-White-18" logo="researchgate" alt="Research Gate"/>
      <CvButton link="https://drive.google.com/file/d/1Fp8XyXQk6Re5hrKr8RrbKu8b_mI2cvn0/view" text="CV" />
    </div>
    
  </div>

  <Separator text="Check out my projects" />
  <Projects />
  <Separator text="Check out my publications" />
  <Publications />
</Layout>